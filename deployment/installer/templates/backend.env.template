# Aveon backend configuration - generated by the installer on first install.
# Re-running INSTALL.cmd never overwrites this file. After editing, restart the
# backend:  schtasks /end /tn AveonBackend  then  schtasks /run /tn AveonBackend
APP_NAME=__BRAND__
# Default organisation name for the sidebar and report headers (editable in
# the web UI under Configuration -> Organization).
BRAND_NAME=__BRAND__
APP_ENV=production
APP_DEBUG=false
API_V1_PREFIX=/api/v1
SECRET_KEY=__SECRET_KEY__
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Built-in administrator login for the web UI.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=__ADMIN_PASSWORD__

# SQL Server connection
SQLSERVER_HOST=__SQL_HOST__
SQLSERVER_PORT=__SQL_PORT__
SQLSERVER_DATABASE=__SQL_DATABASE__
SQLSERVER_USER=__SQL_USER__
SQLSERVER_PASSWORD=__SQL_PASSWORD__
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_ENCRYPT=no

# Browser origins allowed to call the API (the UI is served by IIS on port 80).
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://__SERVER_IP__
WEBHOOK_URL=

# Attendance CSV/FTP export (used by the nightly recalc with --export and by
# POST /api/v1/attendance/export). Leave folder/FTP blank to disable a target.
ATTENDANCE_EXPORT_ENABLED=false
ATTENDANCE_EXPORT_SEPARATOR=,
ATTENDANCE_EXPORT_EXTENSION=csv
ATTENDANCE_EXPORT_PREFIX=attendance_
ATTENDANCE_EXPORT_FOLDER=
ATTENDANCE_EXPORT_FTP_HOST=
ATTENDANCE_EXPORT_FTP_PORT=21
ATTENDANCE_EXPORT_FTP_USER=
ATTENDANCE_EXPORT_FTP_PASSWORD=
ATTENDANCE_EXPORT_FTP_DIR=/
