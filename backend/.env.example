APP_NAME=Biometric Device Management API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=replace_this_with_a_strong_secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_SERVER=localhost
SQLSERVER_DATABASE=BiometricServer
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=YourStrong!Passw0rd
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_ENCRYPT=no
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEBHOOK_URL=

# Attendance CSV/FTP export (used by scripts/recalc_attendance.py --export and
# POST /api/v1/attendance/export). Leave folder/FTP blank to disable a target.
ATTENDANCE_EXPORT_ENABLED=false
ATTENDANCE_EXPORT_SEPARATOR=,
ATTENDANCE_EXPORT_EXTENSION=csv
ATTENDANCE_EXPORT_PREFIX=attendance_
ATTENDANCE_EXPORT_FOLDER=
ATTENDANCE_EXPORT_FTP_HOST=
ATTENDANCE_EXPORT_FTP_PORT=21
ATTENDANCE_EXPORT_FTP_USER=
ATTENDANCE_EXPORT_FTP_PASSWORD=
ATTENDANCE_EXPORT_FTP_DIR=/
