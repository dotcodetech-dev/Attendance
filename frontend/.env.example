# Leave VITE_API_BASE_URL empty so the app calls the API on the SAME origin it is
# served from (works through the IIS proxy on port 80, or any host). The dev
# server (port 5173) automatically falls back to http://localhost:8000/api/v1.
# Only set an explicit value to force a specific backend URL.
VITE_API_BASE_URL=
VITE_BRAND_LOGO_URL=/branding/logo.png
# Brand shown on the login page and browser title (white-label). Default: Aveon Infotech
VITE_BRAND_NAME=Aveon Infotech
