<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS site for Aveon: serves React frontend static files directly (fast),
  and proxies only API / iclock / health routes to uvicorn on port 8000.

  Physical path must point to frontend/dist (or the built client package's
  frontend/dist). Requires URL Rewrite 2.1 + ARR 3.0 and ARR proxy enabled.
-->
<configuration>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />

    <rewrite>
      <rules>
        <!-- Proxy backend routes to uvicorn (API, device push, docs, health). -->
        <rule name="ProxyBackendRoutes" stopProcessing="true">
          <match url="^(api|health|iclock|docs|redoc|openapi\.json)(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8000/{R:0}" appendQueryString="true" />
        </rule>

        <!-- SPA fallback: unknown paths serve index.html for React Router. -->
        <rule name="SPAFallback" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <staticContent>
      <!-- Vite build outputs .webmanifest; IIS doesn't know it by default. -->
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <!-- Older IIS has no .webp type and answers 404 (the login page's logo went missing). Remove first so
           an IIS that already knows .webp does not fail on a duplicate entry. -->
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>

    <security>
      <requestFiltering>
        <!-- Device photo/biophoto pushes can be large; raise the 30 MB default to 200 MB. -->
        <requestLimits maxAllowedContentLength="209715200" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
